# Binaries
/upwatch
/upwatch.exe
/dist/
*.exe
*.test

# Go
/vendor/
*.out
coverage.txt

# Data
*.db
*.db-shm
*.db-wal
/data/

# Frontend
/web/node_modules/
/web/dist/

# O build da interface não entra no versionamento, mas o diretório
# precisa existir: o go:embed aponta para ele, e sem um arquivo dentro o
# pacote não compila. Um clone limpo falharia antes de qualquer teste
# rodar — que é a pior primeira impressão possível.
/internal/web/dist/*
!/internal/web/dist/.gitkeep
# Cache incremental do tsc: muda a cada build e não descreve o código.
/web/tsconfig.tsbuildinfo

# Saída de verificação de interface por navegador.
/.playwright-mcp/

# Env / local config
.env
.env.local
upwatch.local.yaml

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Banco de dados local de desenvolvimento
/upwatch.db*
